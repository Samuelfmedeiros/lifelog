{
  "name": "lifelog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-covers.mjs && python3 scripts/validate-fatos.py --novos && node scripts/gen-ocultos.mjs && astro build && node scripts/validate-saidas-utm.mjs && node scripts/gen-preview-data.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "cleanup": "bash scripts/cleanup-post.sh",
    "cleanup:dist": "bash scripts/cleanup-post.sh --dist",
    "test": "vitest run && playwright test --config e2e/playwright.config.ts",
    "test:headed": "playwright test --headed --config e2e/playwright.config.ts",
    "test:debug": "playwright test --debug --config e2e/playwright.config.ts",
    "lint": "eslint src/ e2e/ --max-warnings 50"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "fuse.js": "^7.5.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^4.1.12",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-security": "^4.2.1",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
