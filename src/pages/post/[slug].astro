---
import PostLayout from '../../components/PostLayout.astro';
import { getCollection } from 'astro:content';

const locale = 'pt';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const posts = allPosts.filter(p => !p.data.hidden && !p.id.startsWith('en/'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const projectLabels = {
  arachne: 'Arachne', dogwalk: 'Dogwalk', portfolio: 'Portfólio',
  capivara: 'Capivara', tatuengine: 'TatuEngine', seguranca: 'Segurança',
  lifelog: 'LifeLog', estudos: 'Estudos', descobertas: 'Descobertas',
};

// Get prev/next posts (same locale)
const allPosts = await getCollection('posts');
const localePosts = allPosts.filter(p => !p.data.hidden && (p.data.lang || 'pt') === locale);
localePosts.sort((a, b) => {
  const aSort = (a.data.pubDate || a.data.date).getTime();
  const bSort = (b.data.pubDate || b.data.date).getTime();
  return bSort - aSort;
});
const currentIndex = localePosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < localePosts.length - 1 ? localePosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? localePosts[currentIndex - 1] : null;

const readingTime = Math.max(1, Math.ceil((post.body?.length || 0) / 1000));

// Contraparte EN do post (11 posts tem slug traduzido, entao o nome do arquivo
// nao basta): casa por nome, senao por (pubDate+project) quando for unico.
const enPosts = allPosts.filter((p) => !p.data.hidden && p.id.startsWith('en/'));
const sameName = enPosts.find((p) => p.id.replace(/^en\//, '') === post.id);
const sameMeta = enPosts.filter((p) =>
  (p.data.pubDate || p.data.date).getTime() === (post.data.pubDate || post.data.date).getTime() &&
  p.data.project === post.data.project);
const enPartner = sameName ?? (sameMeta.length === 1 ? sameMeta[0] : null);
const alternatePath = enPartner ? `/en/post/${enPartner.id.replace(/^en\//, '')}/` : null;

---

<PostLayout
  {post}
  {locale}
  {prevPost}
  {nextPost}
  {projectLabels}
  readLabel={`${readingTime} min de leitura`}
  backText="← Voltar para timeline"
  prevLabel="← Post anterior"
  nextLabel="Próximo post →"
  dateLocale="pt-BR"
  backHref="/"
  postHref="post"
  alternatePath={alternatePath}
/>
