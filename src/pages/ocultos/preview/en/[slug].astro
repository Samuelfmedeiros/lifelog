---
// Preview de post oculto (EN) — igual a en/post/[slug].astro, mas INCLUI hidden:true
// para Samuel revisar a postagem renderizada (capa, formatação, Terminal, shiki)
// ANTES de liberar. NÃO linkada em lugar nenhum (obscuridade, como o /ocultos).
import PostLayout from '../../../../components/PostLayout.astro';
import { getCollection } from 'astro:content';

const locale = 'en';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const posts = allPosts.filter(p => p.id.startsWith('en/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;

const projectLabels = {
  arachne: 'Arachne', dogwalk: 'Dogwalk', portfolio: 'Portfolio',
  capivara: 'Capivara', tatuengine: 'TatuEngine', seguranca: 'Security',
  lifelog: 'LifeLog', estudos: 'Studies', descobertas: 'Discoveries',
};

const allPosts = await getCollection('posts');
const localePosts = allPosts.filter(p => !p.data.hidden && (p.data.lang || 'pt') === locale);
localePosts.sort((a, b) => {
  const aSort = (a.data.pubDate || a.data.date).getTime();
  const bSort = (b.data.pubDate || b.data.date).getTime();
  return bSort - aSort;
});
const currentIndex = localePosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < localePosts.length - 1 ? localePosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? localePosts[currentIndex - 1] : null;

const readingTime = Math.max(1, Math.ceil((post.body?.length || 0) / 1000));

// Contraparte do preview no outro idioma (mesma regra do post publico: nome do
// arquivo, senao par unico por pubDate+project — 11 slugs sao traduzidos).
const other = allPosts.filter((p) => (locale === 'en' ? !p.id.startsWith('en/') : p.id.startsWith('en/')));
const baseId = post.id.replace(/^en\//, '');
const oSameName = other.find((p) => p.id.replace(/^en\//, '') === baseId);
const oSameMeta = other.filter((p) =>
  (p.data.pubDate || p.data.date).getTime() === (post.data.pubDate || post.data.date).getTime() &&
  p.data.project === post.data.project);
const partner = oSameName ?? (oSameMeta.length === 1 ? oSameMeta[0] : null);
const alternatePath = partner
  ? `/ocultos/preview/${locale === 'en' ? 'pt' : 'en'}/${partner.id.replace(/^en\//, '')}/`
  : null;

---

<PostLayout
  {post}
  {locale}
  {prevPost}
  {nextPost}
  {projectLabels}
  readLabel={`${readingTime} min read`}
  backText="← Back to timeline"
  prevLabel="← Previous post"
  nextLabel="Next post →"
  dateLocale="en-US"
  backHref="/en/"
  postHref="en/post"
  alternatePath={alternatePath}
  noindex={true}
/>
