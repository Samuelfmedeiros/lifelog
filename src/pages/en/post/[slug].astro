---
import PostLayout from '../../../components/PostLayout.astro';
import { getCollection } from 'astro:content';

const locale = 'en';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const posts = allPosts.filter(p => !p.data.hidden && p.id.startsWith('en/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;

const projectLabels = {
  arachne: 'Arachne', dogwalk: 'Dogwalk', portfolio: 'Portfolio',
  capivara: 'Capivara', tatuengine: 'TatuEngine', seguranca: 'Security',
  lifelog: 'LifeLog', estudos: 'Studies', descobertas: 'Discoveries',
};

const allPosts = await getCollection('posts');
const localePosts = allPosts.filter(p => !p.data.hidden && (p.data.lang || 'pt') === locale);
localePosts.sort((a, b) => {
  const aSort = (a.data.pubDate || a.data.date).getTime();
  const bSort = (b.data.pubDate || b.data.date).getTime();
  return bSort - aSort;
});
const currentIndex = localePosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < localePosts.length - 1 ? localePosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? localePosts[currentIndex - 1] : null;

const readingTime = Math.max(1, Math.ceil((post.body?.length || 0) / 1000));

// Contraparte PT do post (espelho do post/[slug].astro).
const ptPosts = allPosts.filter((p) => !p.data.hidden && !p.id.startsWith('en/'));
const sameName = ptPosts.find((p) => p.id === post.id.replace(/^en\//, ''));
const sameMeta = ptPosts.filter((p) =>
  (p.data.pubDate || p.data.date).getTime() === (post.data.pubDate || post.data.date).getTime() &&
  p.data.project === post.data.project);
const ptPartner = sameName ?? (sameMeta.length === 1 ? sameMeta[0] : null);
const alternatePath = ptPartner ? `/post/${ptPartner.id}/` : null;

// Related posts (F1.1): 3 from the same project (same locale), fallback recent.
// Filter by id prefix (source of truth): EN posts don't carry lang:'en' in
// frontmatter — the lang field is not reliable (see PT page comment).
const localeRelated = allPosts.filter(p => !p.data.hidden && p.id.startsWith('en/'));
const others = localeRelated.filter(p => p.id !== post.id);
const sameProject = others.filter(p => p.data.project === post.data.project);
const relatedPosts = (sameProject.length >= 3 ? sameProject : [
  ...sameProject,
  ...others.filter(p => !sameProject.includes(p)),
]).slice(0, 3);

---

<PostLayout
  {post}
  {locale}
  {prevPost}
  {nextPost}
  {relatedPosts}
  {projectLabels}
  readLabel={`${readingTime} min read`}
  backText="← Back to timeline"
  prevLabel="← Previous post"
  nextLabel="Next post →"
  dateLocale="en-US"
  backHref="/en/"
  postHref="en/post"
  alternatePath={alternatePath}
/>
