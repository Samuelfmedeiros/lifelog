---
const { date } = Astro.props;
// Sem .toUpperCase(): o card do post mostra "05 de nov. de 2026" e o separador
// precisa bater com ele (achado do crítico visual mobile, 05/11/2026).
const formatted = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<div class="date-separator my-8 first:mt-0">
  {formatted}
</div>
