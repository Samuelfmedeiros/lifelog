---
// PostLayout — Template compartilhado de post (PT e EN)
import BaseLayout from '../layouts/BaseLayout.astro';
import { tagLabel } from '../lib/tag-vocab';
import ProjectIcon from './ProjectIcon.astro';
import RelatedPosts from './RelatedPosts.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'posts'>;
  locale: string;
  prevPost: CollectionEntry<'posts'> | null;
  nextPost: CollectionEntry<'posts'> | null;
  relatedPosts?: CollectionEntry<'posts'>[];
  projectLabels: Record<string, string>;
  readLabel: string;
  backText: string;
  prevLabel: string;
  nextLabel: string;
  dateLocale: string;
  backHref: string;
  postHref: string;
  noindex?: boolean;
  alternatePath?: string | null;
}

const { post, locale, prevPost, nextPost, relatedPosts = [], projectLabels, readLabel, backText, prevLabel, nextLabel, dateLocale, backHref, postHref, noindex, alternatePath } = Astro.props;
const coverImage = post.data.cover;
const { Content } = await render(post);

// JSON-LD (SEO): BlogPosting + BreadcrumbList. Google usa para rich results
// (data, autor, imagem) e para entender a pagina como artigo.
const _pub = post.data.pubDate || post.data.date;
const SITE = (Astro.site?.toString() || 'https://lifelog.seu.pet').replace(/\/$/, '');

// Amarração entre ativos (REGRA-AMARRACAO): todo link cruzado sai com UTM.
// Link sem UTM não é medível — medido em 18/10, o LifeLog linkava 12 páginas sem UTM nenhum.
const _slug = post.id.replace(/^en\//, '');
const _utm = (url: string, medium: string) =>
  `${url}?utm_source=lifelog.seu.pet&utm_medium=${medium}&utm_campaign=post&utm_content=${_slug}`;
const storeHref = _utm('https://skills.seu.pet', 'proximo-passo');
const portfolioHref = _utm('https://portifolio.seu.pet', 'proximo-passo');
const _canonPath = noindex
  ? Astro.url.pathname
  : (locale === 'en' ? `/en/post/${post.id.replace(/^en\//, '')}/` : `/post/${post.id}/`);
const _voltaUrl = `${SITE}${_canonPath}`;
const _img = post.data.cover
  ? (post.data.cover.startsWith('http') ? post.data.cover : SITE + post.data.cover)
  : SITE + '/og-default.png';
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: [_img],
  datePublished: _pub.toISOString(),
  dateModified: _pub.toISOString(),
  inLanguage: locale === 'en' ? 'en' : 'pt-BR',
  articleSection: post.data.project,
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': SITE + _canonPath },
  author: {
    '@type': 'Person',
    name: 'Samuel Medeiros',
    url: 'https://portifolio.seu.pet',
  },
  publisher: {
    '@type': 'Organization',
    name: 'LifeLog',
    logo: { '@type': 'ImageObject', url: SITE + '/og-default.png' },
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'LifeLog', item: SITE + (locale === 'en' ? '/en/' : '/') },
    { '@type': 'ListItem', position: 2, name: post.data.title, item: SITE + _canonPath },
  ],
};
---

<BaseLayout title={post.data.title} description={post.data.description} theme={post.data.project} image={coverImage} type="article" locale={locale} noindex={noindex} alternatePath={alternatePath} schema={noindex ? null : postSchema} schemaExtra={noindex ? null : breadcrumbSchema}>
  <article data-project={post.data.project}>
    <div class="max-w-3xl mx-auto px-4 py-8">
      <!-- Cover Image -->
      <div class="relative w-full aspect-[21/9] mb-10 rounded-2xl overflow-hidden border" style="border-color: var(--color-accent); box-shadow: var(--color-glow);">
        {coverImage ? (
          <img src={coverImage} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover" />
        ) : (
          <>
        <div class="absolute inset-0" style="background: var(--bg-gradient);"></div>
        <div class="absolute inset-0" style="background-image: var(--pattern-url); background-size: 120px; opacity: var(--pattern-opacity); background-blend-mode: var(--pattern-blend);"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <span style="font-size: 5rem; filter: drop-shadow(0 0 40px var(--color-accent)); opacity: 0.6;">
            <ProjectIcon project={post.data.project} />
          </span>
        </div>
        </>
        )}
        <div class="absolute bottom-0 left-0 right-0 h-1" style="background: linear-gradient(90deg, transparent, var(--color-accent), transparent);"></div>
      </div>

      <!-- Header -->
      <header class="mb-12">
        <div class="flex items-center gap-2 text-sm mb-4" style="color: var(--color-accent);">
          <span class="inline-flex items-center gap-1.5"><ProjectIcon project={post.data.project} /> {projectLabels[post.data.project] || post.data.project}</span>
          <span class="opacity-40">·</span>
          <time datetime={(post.data.pubDate || post.data.date).toISOString()} style="color: var(--color-text-muted)">
            {(post.data.pubDate || post.data.date).toLocaleDateString(dateLocale, { day: '2-digit', month: 'long', year: 'numeric' })}
          </time>
        </div>

        <h1 class="text-4xl font-bold mb-4 leading-tight" style="color: var(--color-heading)">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-3 text-sm mb-6" style="color: var(--color-text-muted);">
          <span class="inline-flex items-center gap-1.5"><ProjectIcon project="lifelog" /> {readLabel}</span>
          <span class="w-1 h-1 rounded-full bg-current opacity-40" />
          <a href={backHref} style="color: var(--color-accent); text-decoration: none;"
             class="hover:underline">{backText}</a>
        </div>

        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              ref={el => { if (el) el.style.cssText = `border-color:var(--color-accent);color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 20%,var(--color-bg))` }}
              href={`${locale === 'en' ? '/en/tag/' : '/tag/'}${encodeURIComponent(tag)}`}
              class="px-3 py-1 text-xs rounded-full border border-solid no-underline! transition-[background,opacity] duration-200 hover:opacity-80"
            >#{tagLabel(tag, locale)}</a>
          ))}
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-lg max-w-none" style="color: var(--color-text);">
        <Content />
      </div>

      <RelatedPosts {post} {locale} {relatedPosts} {projectLabels} />

      <!-- Próximo passo — amarração entre ativos (REGRA-AMARRACAO) -->
      <section class="mt-16 pt-8 border-t border-solid" style="border-color: var(--color-border);" id="assinar">
        <h2 class="text-2xl font-bold mb-3" style="color: var(--color-text);">
          {locale === 'en' ? 'Next step' : 'Próximo passo'}
        </h2>
        <p class="mb-5 text-sm" style="color: var(--color-text-muted);">
          {locale === 'en'
            ? 'If this was useful, there is more: I write about the same ground in the other projects, and the store holds the tools I use here.'
            : 'Se isto te serviu, tem mais: escrevo sobre o mesmo assunto nos outros projetos, e a loja tem as ferramentas que eu uso aqui.'}
        </p>

        <form id="assinar-form" method="post"
              action={locale === 'en' ? 'https://skills.seu.pet/en/assinar' : 'https://skills.seu.pet/assinar'}
              class="flex flex-wrap gap-3 items-end mb-3">
          <input type="hidden" name="origem" value="lifelog" />
          <input type="hidden" name="volta" value={_voltaUrl} />
          <label class="sr-only" for="assinar-email">E-mail</label>
          <input id="assinar-email" type="email" name="email" required maxlength="254" autocomplete="email"
                 placeholder={locale === 'en' ? 'you@example.com' : 'voce@exemplo.com'}
                 class="px-3 py-2 rounded-lg border border-solid text-sm grow min-w-[220px]"
                 style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text);" />
          <input type="text" name="site" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold cursor-pointer border-0"
                  style="background: var(--color-accent); color: var(--color-bg);">
            {locale === 'en' ? 'Send me the articles' : 'Receber os artigos'}
          </button>
        </form>

        <p id="assinar-ok" class="hidden text-sm font-medium mb-3" style="color: var(--color-accent);">
          {locale === 'en'
            ? 'Done — I will send the next article when it is out.'
            : 'Anotado — aviso quando sair artigo novo.'}
        </p>

        <p class="text-sm" style="color: var(--color-text-muted);">
          {locale === 'en' ? 'No spam, one-click unsubscribe. I am also here:' : 'Sem spam, descadastro de um clique. Também estou aqui:'}
          {' '}
          <a href={storeHref} style="color: var(--color-accent);">{locale === 'en' ? 'Skills store' : 'Loja de skills'}</a>
          {' · '}
          <a href={portfolioHref} style="color: var(--color-accent);">{locale === 'en' ? 'Portfolio' : 'Portfólio'}</a>
        </p>
      </section>

      <script>
        // Volta da captura (a loja redireciona pra cá com ?ok=1): troca o formulário
        // pela confirmação — sem isso a pessoa volta, vê o mesmo formulário e acha que falhou.
        const q = new URLSearchParams(location.search);
        if (q.get('ok') === '1') {
          document.getElementById('assinar-form')?.classList.add('hidden');
          document.getElementById('assinar-ok')?.classList.remove('hidden');
        }
      </script>

      <!-- Navigation: Prev / Next -->
      <nav class="mt-16 pt-8 border-t" style="border-color: var(--color-border);">
        <div class="grid grid-cols-2 gap-6">
          <div>
            {prevPost && (
              <a href={`/${postHref}/${prevPost.id.replace('en/', '')}`} class="group block no-underline!">
                <span class="text-xs font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">
                  {prevLabel}
                </span>
                <span class="block mt-1 text-sm font-medium group-hover:underline"
                      style="color: var(--color-accent);">
                  <span class="inline-flex items-center gap-1.5"><ProjectIcon project={prevPost.data.project} /> {prevPost.data.title}</span>
                </span>
              </a>
            )}
          </div>
          <div class="text-right">
            {nextPost && (
              <a href={`/${postHref}/${nextPost.id.replace('en/', '')}`} class="group block no-underline!">
                <span class="text-xs font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">
                  {nextLabel}
                </span>
                <span class="block mt-1 text-sm font-medium group-hover:underline"
                      style="color: var(--color-accent);">
                  <span class="inline-flex items-center gap-1.5">{nextPost.data.title} <ProjectIcon project={nextPost.data.project} /></span>
                </span>
              </a>
            )}
          </div>
        </div>

        <div class="mt-6 text-center">
          <a href={backHref} class="inline-flex items-center gap-1 text-sm font-medium hover:underline no-underline!"
             style="color: var(--color-accent);">
            {backText}
          </a>
        </div>
      </nav>
    </div>
  </article>
</BaseLayout>

<style is:global>
  article[data-project] .prose h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    color: var(--color-heading);
    border-bottom: 1px solid var(--color-border);
  }
  article[data-project] .prose h3 {
    font-size: 1.35rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }
  article[data-project] .prose p {
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  article[data-project] .prose code {
    font-size: 0.875rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
  }
  article[data-project] .prose pre {
    padding: 1.25rem;
    border-radius: 12px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  article[data-project] .prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text);
  }
  article[data-project] .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  article[data-project] .prose a:hover { opacity: 0.8; }
  article[data-project] .prose ul, article[data-project] .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  article[data-project] .prose li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  article[data-project] .prose blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-muted);
    background: var(--color-accent-soft);
    padding: 1rem 1rem 1rem 1.5rem;
    border-radius: 8px;
  }
  article[data-project] .prose img {
    border-radius: 12px;
    margin: 1.5rem auto;
    border: 1px solid var(--color-border);
  }
  article[data-project] .prose hr {
    border-color: var(--color-border);
    margin: 2rem 0;
  }
  article[data-project] .prose strong {
    color: var(--color-heading);
  }
  .prose .highlight-box {
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent);
    border-radius: 12px;
    padding: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-accent);
    font-weight: 500;
  }
  @media (max-width: 768px) {
    article[data-project] h1 { font-size: 1.5rem !important; }
    article[data-project] .prose h2 { font-size: 1.35rem !important; }
    article[data-project] .prose h3 { font-size: 1.1rem !important; }
    article[data-project] .prose p, article[data-project] .prose li { font-size: 0.9375rem; }
    article[data-project] .prose pre { padding: 0.875rem !important; font-size: 0.8125rem; }
  }

  /* Amarração — alvo de toque de 44px (regra do dono).
     Medido em 18/10 antes do fix: botão 36px e input 38px no mobile — abaixo do mínimo. */
  #assinar input[type='email'],
  #assinar button {
    min-height: 44px;
  }

  /* Amarração — contraste no tema claro.
     O axe pegou 3.53:1 no botão (19/10, CI): eu usei `color: var(--color-bg)` e no tema
     claro esse valor é quase branco (#f5f2eb) sobre o accent (#a855f7). Accent como FUNDO
     precisa escurecer; accent como TEXTO pequeno precisa do mix documentado na skill
     (60% accent + #1a1a2e). Vale para qualquer das 6 paletas. */
  [data-theme='light'] #assinar button {
    /* !important é necessário: o botão carrega style inline (que ganha de qualquer regra).
       A skill já registra esse caso nas páginas de post. */
    background: color-mix(in srgb, var(--color-accent) 55%, #1a1a2e) !important;
    color: #ffffff !important;
  }
  [data-theme='light'] #assinar-ok,
  [data-theme='light'] #assinar a {
    color: color-mix(in srgb, var(--color-accent) 60%, #1a1a2e) !important;
  }
</style>
