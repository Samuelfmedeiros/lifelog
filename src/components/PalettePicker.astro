---
// ThemeRail — Controls: tema, cor (dropdown), idioma
// Layout: [Tema] [Cor ▼]
// Paleta abre dropdown pra baixo com 6 dots
import { PALETTES } from '../lib/palettes'
---

<div id="theme-rail" class="theme-rail">
  <!-- Theme Toggle -->
  <button id="rail-theme" class="rail-btn" aria-label="Alternar tema" title="Alternar tema">
    <span id="rail-theme-icon" class="rail-icon" aria-hidden="true"><svg id="rail-theme-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M12 3c-4.4 0-8 3.6-8 8s3.6 8 8 8c1.7 0 3.3-.5 4.6-1.4C10.9 16.4 8.5 13 8.5 9c0-2.2.8-4.3 2.3-6H12z"/></svg></span>
  </button>

  <!-- Color Button (abre dropdown pra baixo) -->
  <div class="rail-color-wrap">
    <button id="rail-color" class="rail-btn rail-btn-color" aria-label="Paleta de cores" title="Paleta de cores">
      <span class="rail-palette-indicator" id="rail-indicator"></span>
    </button>
    <div id="rail-color-dropdown" class="rail-dropdown">
      {PALETTES.map((p, i) => (
        <button
          id={`rail-palette-${i}`}
          class="rail-dot"
          style={`--dot-color: ${p.accentDark}`}
          data-palette={p.id}
          aria-label={`Paleta ${p.name}`}
          title={p.name}
        ></button>
      ))}
    </div>
  </div>

</div>

<style>
  /* ═══════════════════════════════════════════
     Theme Rail — Inline controls + color dropdown
     ═══════════════════════════════════════════ */
  .theme-rail {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  /* ─── Shared button style ─── */
  .rail-btn {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    transition: all 0.2s ease;
    flex-shrink: 0;
    position: relative;
  }
  .rail-btn:hover {
    opacity: 1;
    background: var(--color-accent-soft);
    transform: scale(1.08);
  }
  .rail-btn:active { transform: scale(0.92); }

  /* Theme toggle — morph calculado (lua↔sol). O conteúdo SVG já troca via
     setTheme(); aqui só suavizamos o círculo do globo quando o ícone gira. */
  #rail-theme-svg {
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) !important;
    will-change: transform;
  }
  .rail-btn:hover #rail-theme-svg {
    transform: rotate(180deg) scale(1.12);
  }
  .rail-btn:active #rail-theme-svg {
    transform: rotate(180deg) scale(0.98);
  }
  .rail-icon {
    font-size: 1.15rem;
    line-height: 1;
    pointer-events: none;
  }

  /* ─── Color button ─── */
  .rail-color-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .rail-btn-color {
    font-size: 0;
  }
  .rail-palette-indicator {
    display: block;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 0;
    box-shadow: var(--color-glow);
    transition: all 0.3s ease;
    pointer-events: none;
    box-sizing: border-box;
    flex-shrink: 0;
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  /* Ring pulsante da cor ativa — dá feedback visual imediato da paleta */
  .rail-btn-color::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 10px;
    border: 2px solid transparent;
    transition: border-color 0.3s ease;
    pointer-events: none;
  }
  .rail-btn-color:hover::before {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  /* ─── Dropdown (abre pra baixo, posicionado por JS fixed) ─── */
  .rail-dropdown {
    position: fixed;
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    /* Fallback: sólido pra browsers sem color-mix() */
    background: var(--color-bg);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1000;
    white-space: nowrap;
    transform: translateY(-4px);
    pointer-events: none;
    margin: 0;
  }
  .rail-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Stagger — dots surgem em cascata ao abrir o dropdown */
  .rail-dropdown .rail-dot {
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1), transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .rail-dropdown.open .rail-dot {
    opacity: 0.5;
    transform: scale(1);
  }
  .rail-dropdown.open .rail-dot:nth-child(1) { transition-delay: 0ms; }
  .rail-dropdown.open .rail-dot:nth-child(2) { transition-delay: 30ms; }
  .rail-dropdown.open .rail-dot:nth-child(3) { transition-delay: 60ms; }
  .rail-dropdown.open .rail-dot:nth-child(4) { transition-delay: 90ms; }
  .rail-dropdown.open .rail-dot:nth-child(5) { transition-delay: 120ms; }
  .rail-dropdown.open .rail-dot:nth-child(6) { transition-delay: 150ms; }
  .rail-dropdown.open .rail-dot:hover { opacity: 0.9; transform: scale(1.25); }
  .rail-dropdown.open .rail-dot.active { opacity: 1; }

  /* ─── Palette dots ─── */
  .rail-dot {
    all: unset;
    cursor: pointer;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--dot-color);
    opacity: 0.5;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }
  .rail-dot:hover {
    opacity: 0.9;
    transform: scale(1.25);
  }
  .rail-dot:active { transform: scale(0.9); }
  .rail-dot.active {
    opacity: 1;
    border-color: var(--color-accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 50%, transparent);
    transform: scale(1.2);
  }

  /* ─── Mobile ─── */
  @media (max-width: 768px) {
    .rail-btn { width: 30px; height: 30px; }
    .rail-icon { font-size: 1rem; }
    .rail-palette-indicator { width: 16px; height: 16px; }
    .rail-dot { width: 16px; height: 16px; }
    .rail-dropdown { padding: 7px 9px; gap: 5px; }
  }
  @media (max-width: 480px) {
    .rail-btn { width: 30px; height: 30px; }
    .rail-icon { font-size: 0.95rem; }
    .rail-palette-indicator { width: 16px; height: 16px; }
    .rail-dot { width: 18px; height: 18px; }
    .rail-dropdown {
      padding: 8px 10px; gap: 6px;
    }
  }
</style>

<script is:inline>
(function() {
  const PALETTE_KEY = 'lifelog-palette'
  const THEME_KEY = 'lifelog-theme'
  let animating = false
  let lastTouchX = 0, lastTouchY = 0

  // ═══════════════════════════════════════
  // PALETTES — must match src/lib/palettes.ts (single source of truth)
  // ═══════════════════════════════════════
  const PALETTES = [
    {id:"purple",name:"Roxo",aD:"#a78bfa",aL:"#7c3aed",bD:"rgba(167,139,250,0.25)",bL:"rgba(124,58,237,0.2)",gD:"0 0 30px rgba(167,139,250,0.15)",gL:"0 4px 24px rgba(124,58,237,0.12)",tB:"rgba(167,139,250,0.12)",pD:"rgba(200,180,255,0.6)",pL:"rgba(124,58,237,0.15)",aD2:"radial-gradient(ellipse at 30% 20%, rgba(167,139,250,0.06) 0%, transparent 60%)",aL2:"radial-gradient(ellipse at 80% 10%, rgba(124,58,237,0.12) 0%, transparent 50%)",sD:"0 8px 32px rgba(167,139,250,0.06)",sL:"0 4px 16px rgba(124,58,237,0.06)"},
    {id:"cyan",name:"Ciano",aD:"#22d3ee",aL:"#0891b2",bD:"rgba(34,211,238,0.25)",bL:"rgba(8,145,178,0.2)",gD:"0 0 30px rgba(34,211,238,0.15)",gL:"0 4px 24px rgba(8,145,178,0.12)",tB:"rgba(34,211,238,0.12)",pD:"rgba(150,230,255,0.6)",pL:"rgba(8,145,178,0.15)",aD2:"radial-gradient(ellipse at 20% 30%, rgba(34,211,238,0.06) 0%, transparent 60%)",aL2:"radial-gradient(ellipse at 70% 15%, rgba(8,145,178,0.12) 0%, transparent 50%)",sD:"0 8px 32px rgba(34,211,238,0.06)",sL:"0 4px 16px rgba(8,145,178,0.06)"},
    {id:"emerald",name:"Verde",aD:"#34d399",aL:"#059669",bD:"rgba(52,211,153,0.25)",bL:"rgba(5,150,105,0.2)",gD:"0 0 30px rgba(52,211,153,0.15)",gL:"0 4px 24px rgba(5,150,105,0.12)",tB:"rgba(52,211,153,0.12)",pD:"rgba(150,240,200,0.6)",pL:"rgba(5,150,105,0.15)",aD2:"radial-gradient(ellipse at 40% 20%, rgba(52,211,153,0.05) 0%, transparent 60%)",aL2:"radial-gradient(ellipse at 60% 10%, rgba(5,150,105,0.12) 0%, transparent 50%)",sD:"0 8px 32px rgba(52,211,153,0.06)",sL:"0 4px 16px rgba(5,150,105,0.06)"},
    {id:"amber",name:"Âmbar",aD:"#fbbf24",aL:"#d97706",bD:"rgba(251,191,36,0.25)",bL:"rgba(217,119,6,0.2)",gD:"0 0 30px rgba(251,191,36,0.15)",gL:"0 4px 24px rgba(217,119,6,0.12)",tB:"rgba(251,191,36,0.12)",pD:"rgba(255,220,150,0.6)",pL:"rgba(217,119,6,0.15)",aD2:"radial-gradient(ellipse at 50% 30%, rgba(251,191,36,0.05) 0%, transparent 60%)",aL2:"radial-gradient(ellipse at 85% 10%, rgba(217,119,6,0.12) 0%, transparent 50%)",sD:"0 8px 32px rgba(251,191,36,0.06)",sL:"0 4px 16px rgba(217,119,6,0.06)"},
    {id:"rose",name:"Rosa",aD:"#fb7185",aL:"#e11d48",bD:"rgba(251,113,133,0.25)",bL:"rgba(225,29,72,0.2)",gD:"0 0 30px rgba(251,113,133,0.15)",gL:"0 4px 24px rgba(225,29,72,0.12)",tB:"rgba(251,113,133,0.12)",pD:"rgba(255,180,200,0.6)",pL:"rgba(225,29,72,0.12)",aD2:"radial-gradient(ellipse at 30% 40%, rgba(251,113,133,0.05) 0%, transparent 60%)",aL2:"radial-gradient(ellipse at 75% 15%, rgba(225,29,72,0.12) 0%, transparent 50%)",sD:"0 8px 32px rgba(251,113,133,0.06)",sL:"0 4px 16px rgba(225,29,72,0.06)"},
    {id:"blue",name:"Azul",aD:"#60a5fa",aL:"#2563eb",bD:"rgba(96,165,250,0.25)",bL:"rgba(37,99,235,0.2)",gD:"0 0 30px rgba(96,165,250,0.15)",gL:"0 4px 24px rgba(37,99,235,0.12)",tB:"rgba(96,165,250,0.12)",pD:"rgba(160,200,255,0.6)",pL:"rgba(37,99,235,0.15)",aD2:"radial-gradient(ellipse at 25% 25%, rgba(96,165,250,0.05) 0%, transparent 60%)",aL2:"radial-gradient(ellipse at 65% 10%, rgba(37,99,235,0.12) 0%, transparent 50%)",sD:"0 8px 32px rgba(96,165,250,0.06)",sL:"0 4px 16px rgba(37,99,235,0.06)"},
  ]
  function getP(id) { return PALETTES.find(p => p.id === id) || PALETTES[0] }

  function getSaved(k, d) { try { const v = localStorage.getItem(k); if (v) return v } catch {} return d }
  function save(k, v) { try { localStorage.setItem(k, v) } catch {} }

  function isDark() { return document.documentElement.getAttribute('data-theme') !== 'light' }

  /* ─── Palette ─── */
  function applyPalette(id, persist) {
    const p = getP(id)
    const dark = isDark()
    const root = document.documentElement
    root.style.setProperty('--color-accent', dark ? p.aD : p.aL)
    // CTA (botão Portfólio) sempre usa a versão ESCURA do accent + letra branca
    root.style.setProperty('--navbar-cta-bg', p.aL)
    root.style.setProperty('--navbar-cta-color', '#ffffff')
    root.style.setProperty('--color-accent-soft', p.tB)
    root.style.setProperty('--color-glow', dark ? p.gD : p.gL)
    root.style.setProperty('--color-border', dark ? p.bD : p.bL)
    root.style.setProperty('--particle-color', dark ? p.pD : p.pL)
    root.style.setProperty('--aura-gradient', dark ? p.aD2 : p.aL2)
    root.style.setProperty('--card-shadow', dark ? p.sD : p.sL)
    // indicator dot
    const ind = document.getElementById('rail-indicator')
    if (ind) ind.style.background = dark ? p.aD : p.aL
    // highlight dots
    document.querySelectorAll('.rail-dot').forEach(el => {
      el.classList.toggle('active', el.dataset.palette === id)
    })
    if (persist !== false) save(PALETTE_KEY, id)
    document.dispatchEvent(new CustomEvent('lifelog-palette-change', { detail: { palette: id } }))
  }

  /* ─── Theme ─── */
  function setTheme(theme, persist) {
    const root = document.documentElement
    root.setAttribute('data-theme', theme)
    root.classList.toggle('dark', theme !== 'light')
    root.classList.toggle('light', theme === 'light')
    const themeIcon = document.getElementById('rail-theme-icon');
    const themeSvg = document.getElementById('rail-theme-svg');
    if (themeSvg) {
      const isLight = theme === 'light';
      // Sol: círculo + raios. Lua: meia-lua.
      themeSvg.innerHTML = isLight
        ? '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8" stroke-linecap="round"/>'
        : '<path d="M12 3c-4.4 0-8 3.6-8 8s3.6 8 8 8c1.7 0 3.3-.5 4.6-1.4C10.9 16.4 8.5 13 8.5 9c0-2.2.8-4.3 2.3-6H12z"/>';
    }
    const pid = getSaved(PALETTE_KEY, 'purple')
    applyPalette(pid, false)
    if (persist !== false) save(THEME_KEY, theme)
    document.dispatchEvent(new CustomEvent('lifelog-theme-change', { detail: { theme } }))
  }

  function toggleTheme(e) {
    if (animating) return
    const cur = document.documentElement.getAttribute('data-theme')
    const next = cur === 'light' ? 'dark' : 'light'

    // Origem do círculo — SEMPRE a posição do toque, senão clientX/Y válidos,
    // senão o CENTRO DO BOTÃO de tema (nunca o centro da tela). Cliques
    // sintetizados (ghost click mobile pós-scroll, atalho de teclado Enter)
    // podem vir com clientX=0 — o ?? deixa 0 passar e o círculo nascia no
    // canto (0,0) ou no centro da viewport.
    function themeOrigin(ev) {
      const btn = document.getElementById('rail-theme')
      const rect = btn?.getBoundingClientRect()
      const btnX = rect ? rect.left + rect.width / 2 : innerWidth / 2
      const btnY = rect ? rect.top + rect.height / 2 : innerHeight / 2
      const x = lastTouchX > 0 ? lastTouchX : (ev && ev.clientX > 0 ? ev.clientX : btnX)
      const y = lastTouchY > 0 ? lastTouchY : (ev && ev.clientY > 0 ? ev.clientY : btnY)
      return [x, y]
    }

    if (document.startViewTransition) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setTheme(next); return
      }

      // ─── Círculo expansivo — MESMO no mobile (sincronizado com a web) ───
      // Samuel quer a troca de temas com animação circular no mobile TAMBÉM
      // (12/08/2026 — reverter crossfade do 08a3d2d). Mobile usa duração
      // menor (700ms) + easing ease-in-out suave — 14/08: Samuel pediu MAIS
      // LENTO + fluido do início ao fim (o ease-out anterior congelava no
      // final; ease-in-out não trava e mantém fluidez). Anti-stutter:
      // isolation + mix-blend normal + vt-running desliga CSS transitions.
      const isMobile = window.innerWidth <= 768
      const animDuration = isMobile ? 700 : 1400
      const easing = 'cubic-bezier(0.45, 0, 0.55, 1)' // ease-in-out suave: sem trava no final

      // Clip-path circular — único caminho (mobile E desktop), origem = toque
      // PITFALL CRITICO (skill view-transitions-theme-animations): NUNCA
      // sincronizar a limpeza com t.finished — como o global.css seta
      // animation:none nos pseudo-elementos do VT, o t.finished resolve ~0ms,
      // ANTES da animação WAAPI (400/800ms) terminar. Se limpar por ele,
      // animating=false volta cedo → segundo clique no meio dispara outra
      // animação (origem errada) + vt-running removido cedo → CSS transitions
      // voltam → stutter. Sincronizar SEMPRE pelo .finished da PRÓPRIA
      // animação WAAPI (done), não pelo finished do ViewTransition.
      const [x, y] = themeOrigin(e)
      document.documentElement.classList.add('vt-running')
      const t = document.startViewTransition(() => setTheme(next))
      animating = true

      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
      const done = t.ready.then(() =>
        document.documentElement.animate(
          { clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${r}px at ${x}px ${y}px)`
          ]},
          { duration: animDuration, easing, pseudoElement: '::view-transition-new(root)' },
        ).finished
      )
      // Safety: se done nunca resolver (edge case), não deixar vt-running
      // preso — transitions ficariam desligadas pra sempre. NUNCA cortar a
      // animação em andamento: em devices lentos o t.ready atrasa (main
      // thread ocupado) e o timeout antigo fixo (1500ms) limpava ANTES do
      // círculo terminar = stutter no fim / "trava pela metade". A flag
      // finished garante que o finally cuida do caso normal; este timeout
      // só age se done nunca resolver. Margem: duração + 1.5s de folga.
      let finished = false
      done.catch(() => setTheme(next)).finally(() => {
        finished = true
        animating = false
        // Reset da origem — não deixar o toque antigo vazar pro próximo
        // clique (ghost click pós-scroll usaria posição de outra viewport)
        lastTouchX = 0; lastTouchY = 0
        document.documentElement.classList.remove('vt-running')
      })
      setTimeout(() => {
        if (finished) return
        animating = false
        lastTouchX = 0; lastTouchY = 0
        document.documentElement.classList.remove('vt-running')
      }, animDuration + 1500)
      return
    }

    // ─── Fallback (sem VT) — overlay clip-path circular ───
    // Mesma prioridade: toque real > clientX/Y > centro do botão.
    // Simplificado (14/08, opção B): mesmo raio do caminho VT (viewport,
    // não documento — o overlay é fixed e cobre só a viewport), duração
    // consistente com o principal (700 mobile / 1400 desktop), sem
    // will-change (micro-otimização desnecessária em overlay de 1s).
    const [fx, fy] = themeOrigin(e)
    if (e && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      animating = true
      // Cores REAIS dos temas (themes.css): light = creme #f5f2eb, dark = #0a0a0f.
      // NÃO ler getComputedStyle aqui — o --color-bg computado é do tema ATUAL,
      // e o overlay precisa da cor do tema DESTINO (next).
      const fallbackMs = window.innerWidth <= 768 ? 700 : 1400
      const overlay = document.createElement('div')
      overlay.style.cssText =
        'position:fixed;inset:0;z-index:9999;pointer-events:none;' +
        'clip-path:circle(0px at ' + fx + 'px ' + fy + 'px);' +
        'background:' + (next === 'light' ? '#f5f2eb' : '#0a0a0f') + ';' +
        'transition:clip-path ' + (fallbackMs / 1000) + 's cubic-bezier(0.45, 0, 0.55, 1)'
      document.body.appendChild(overlay)
      overlay.offsetHeight // force layout
      const endR = Math.hypot(
        Math.max(fx, innerWidth - fx),
        Math.max(fy, innerHeight - fy)
      )
      overlay.style.clipPath = 'circle(' + endR + 'px at ' + fx + 'px ' + fy + 'px)'
      // Timing alinhado: espera a expansão cobrir TUDO, SÓ ENTÃO muda o
      // tema + remove overlay. Mudar antes = flash do tema novo fora do círculo.
      setTimeout(() => {
        setTheme(next)
        overlay.remove()
        animating = false
        lastTouchX = 0; lastTouchY = 0
      }, fallbackMs)
    } else {
      setTheme(next)
    }
  }

  /* ─── Dropdown toggle ─── */
  function toggleDropdown(e) {
    e.stopPropagation()
    const dd = document.getElementById('rail-color-dropdown')
    if (!dd) return
    const wasOpen = dd.classList.contains('open')
    // close all dropdowns first
    document.querySelectorAll('.rail-dropdown.open').forEach(el => {
      el.classList.remove('open')
      el.style.top = ''
      el.style.left = ''
    })
    if (!wasOpen) {
      const btn = document.getElementById('rail-color')
      if (!btn) return
      const rect = btn.getBoundingClientRect()
      const ddW = dd.offsetWidth || 200
      const ddH = dd.offsetHeight || 50
      const margin = 8

      // Center under button
      let left = rect.left + (rect.width / 2) - (ddW / 2)
      left = Math.max(margin, Math.min(left, window.innerWidth - ddW - margin))

      const spaceBelow = window.innerHeight - rect.bottom
      const spaceAbove = rect.top

      if (spaceBelow >= ddH + margin) {
        // Abre pra baixo
        dd.style.top = (rect.bottom + 6) + 'px'
        dd.classList.remove('drop-up')
      } else if (spaceAbove >= ddH + margin) {
        // Abre pra cima com viewport clamp
        let topVal = rect.top - ddH - 6
        if (topVal < margin) topVal = margin
        dd.style.top = topVal + 'px'
        dd.classList.add('drop-up')
      } else {
        // Tela muito pequena — centraliza verticalmente
        dd.style.top = Math.max(margin, (window.innerHeight - ddH) / 2) + 'px'
        dd.classList.add('drop-up')
      }
      dd.style.left = left + 'px'
      dd.classList.add('open')
    }
  }

  /* ─── Init ─── */
  const savedTheme = getSaved(THEME_KEY, 'dark')
  setTheme(savedTheme, false)
  const savedPalette = getSaved(PALETTE_KEY, 'purple')
  applyPalette(savedPalette, false)
  /* ─── Events ─── */
  document.addEventListener('touchstart', function(e) {
    const btn = document.getElementById('rail-theme')
    if (btn && btn.contains(e.target)) {
      const t = e.changedTouches?.[0]
      if (t) { lastTouchX = t.clientX; lastTouchY = t.clientY }
    }
  }, { passive: true })

  document.addEventListener('click', function(e) {
    const t = e.target
    const themeBtn = document.getElementById('rail-theme')
    const colorBtn = document.getElementById('rail-color')
    const colorWrap = document.getElementById('rail-color-wrap')

    // Theme
    if (themeBtn && (t === themeBtn || themeBtn.contains(t))) { toggleTheme(e); return }
    // Color button → toggle dropdown
    if (colorBtn && (t === colorBtn || colorBtn.contains(t))) { toggleDropdown(e); return }
    // Palette dot inside dropdown
    const dot = t.closest('.rail-dot')
    if (dot && dot.dataset.palette) {
      applyPalette(dot.dataset.palette)
      document.querySelectorAll('.rail-dropdown.open').forEach(el => {
        el.classList.remove('open')
        el.style.top = ''
        el.style.left = ''
      })
      return
    }
    // Click outside → close dropdown
    if (!colorBtn || !colorBtn.parentElement?.contains(t)) {
      document.querySelectorAll('.rail-dropdown.open').forEach(el => {
        el.classList.remove('open')
        el.style.top = ''
        el.style.left = ''
      })
    }
  })

  document.addEventListener('lifelog-palette-reapply', function(e) {
    const pid = e.detail && e.detail.palette
    if (pid) applyPalette(pid, false)
  })
})()
</script>
