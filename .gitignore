# Scripts temporários (demo, captura, geração)
# scripts/  -- removed: scripts/generate-cover.py é mantido

# Screenshots e capturas na raiz
*.png
# icones PWA: o '*.png' acima bloqueava o commit destes arquivos (por isso
# /icons/lifelog-{192,512}.png nunca existiram e o manifest.json dava 404)
!public/icons/*.png
# imagem OG padrao (fix handoff Arachne 14/09): mesma armadilha do '*.png'
!public/og-default.png
*.webm
*.mp4

# Exceção: baselines do VRT (Playwright toHaveScreenshot) SÃO versionados
!e2e/vrt.spec.ts-snapshots/
!e2e/vrt.spec.ts-snapshots/**

# Demo videos & frames
demo*.mp4
demo*.webm
*.webm
.tmp_frames/

# Draft queue
src/content/drafts/queue.json

# Generated test assets
public/demo-*.mp4
public/demo-*.webm
public/page-*.webm
public/*-test*.png
public/light_*.png
public/test-light*.png
.vercel
.env*

# Auto-post state
.auto-post-state.json
.loop-state.json
.tmp-*

# symlink que o pnpm cria em worktree. O padrao 'node_modules/' (com barra)
# NAO pega symlink, e um symlink rastreado quebra 'pnpm install' no runner
# com ENOTDIR (incidente 13/09). O padrao abaixo cobre arquivo e diretorio.
node_modules
